@model CarCounter.Models.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    var colours = CarCounter.Models.AvailableColours.All;
}

<h1>⚙️ Settings</h1>
<p>Choose three different colours for your cars.</p>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Save" method="post" id="settingsForm">
    <div class="row mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">Car 1</label>
            <select name="Colour1" class="form-select colour-picker">
                @foreach (var c in colours)
                {
                    if (c.Name == Model.Colour1)
                    {
                        <option value="@c.Name" selected>@c.Emoji @c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Name">@c.Emoji @c.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">Car 2</label>
            <select name="Colour2" class="form-select colour-picker">
                @foreach (var c in colours)
                {
                    if (c.Name == Model.Colour2)
                    {
                        <option value="@c.Name" selected>@c.Emoji @c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Name">@c.Emoji @c.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">Car 3</label>
            <select name="Colour3" class="form-select colour-picker">
                @foreach (var c in colours)
                {
                    if (c.Name == Model.Colour3)
                    {
                        <option value="@c.Name" selected>@c.Emoji @c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Name">@c.Emoji @c.Name</option>
                    }
                }
            </select>
        </div>
    </div>

    <div id="duplicateWarning" class="alert alert-danger d-none">
        Each car must be a different colour.
    </div>

    <button type="submit" class="btn btn-primary btn-lg" id="saveBtn">💾 Save &amp; Start</button>
    <a asp-controller="CarCounter" asp-action="Index" class="btn btn-outline-secondary btn-lg ms-2">Cancel</a>
</form>

@section Scripts {
    <script>
        (function () {
            const pickers = document.querySelectorAll('.colour-picker');
            const warning = document.getElementById('duplicateWarning');
            const saveBtn = document.getElementById('saveBtn');
            const form = document.getElementById('settingsForm');
            const gameInProgress = @(Model.GameInProgress ? "true" : "false");

            function checkDuplicates() {
                const values = Array.from(pickers).map(s => s.value);
                const hasDup = new Set(values).size < values.length;
                warning.classList.toggle('d-none', !hasDup);
                saveBtn.disabled = hasDup;
            }

            pickers.forEach(p => p.addEventListener('change', checkDuplicates));
            checkDuplicates();

            form.addEventListener('submit', function (e) {
                if (gameInProgress) {
                    if (!confirm('A game is in progress. Changing colours will restart the game. Continue?')) {
                        e.preventDefault();
                    }
                }
            });
        })();
    </script>
}
